# Copy to keystore.properties (same folder; git-ignored) and fill in your upload key.
# The .keystore file path is relative to android/app.
MYAPP_UPLOAD_STORE_FILE=REPLACE_ME-upload.keystore
MYAPP_UPLOAD_KEY_ALIAS=REPLACE_ME_alias
MYAPP_UPLOAD_STORE_PASSWORD=REPLACE_ME_store_password
MYAPP_UPLOAD_KEY_PASSWORD=REPLACE_ME_key_password
